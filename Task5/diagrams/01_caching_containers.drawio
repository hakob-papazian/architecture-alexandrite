<object placeholders="1" c4Name="MES Cache" c4Type="Container" c4Technology="Yandex Managed Valkey / Redis, 2 узла" c4Description="Страницы списка заказов и счётчики по статусам (Cache-Aside, версии ключей), результаты анализа 3D-моделей по хешу" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="cache-redis">
  <mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#E53935;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#B71C1C;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1"><mxGeometry x="880" y="1290" width="280" height="130" as="geometry" /></mxCell></object>
<mxCell id="cache-e-api" value="GET/SET, INCR версии, PUBLISH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E53935;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="6bDfexBDMjg7O7AECw8N-1" target="cache-redis" edge="1"><mxGeometry x="0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="998" /><mxPoint x="830" y="1355" /></Array></mxGeometry></mxCell>
<mxCell id="cache-e-push" value="WebSocket: orders.changed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E53935;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=classic;endFill=1;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="6bDfexBDMjg7O7AECw8N-1" target="6bDfexBDMjg7O7AECw8N-4" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-75" y="0" as="offset" /></mxGeometry></mxCell>
<mxCell id="cache-t-mes" value="Cache-Aside + инвалидация по событию" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#E53935;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="545" y="862" width="230" height="24" as="geometry" /></mxCell>
<mxCell id="cache-t-ui" value="HTTP-кеш: статика, справочники, ETag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#E53935;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="535" y="1236" width="230" height="24" as="geometry" /></mxCell>
<mxCell id="cache-legend" value="&lt;b&gt;&lt;font color=&quot;#C62828&quot; style=&quot;font-size:14px&quot;&gt;Что меняется&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;MES Cache&lt;/b&gt; — новый контейнер. MES API читает список заказов из кеша, при промахе — из MES DB (Cache-Aside).&lt;br&gt;&lt;br&gt;&#xa;При смене статуса MES API после коммита в MES DB увеличивает версию ключей затронутых статусов (инвалидация) и публикует событие.&lt;br&gt;&lt;br&gt;&#xa;MES UI получает событие по WebSocket и перечитывает первую страницу — без ручного обновления и опроса.&lt;br&gt;&lt;br&gt;&#xa;Результат анализа 3D-модели (вес металла, трудоёмкость) кешируется по хешу файла — повторный расчёт той же модели не запускается." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E53935;strokeWidth=2;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="1800" y="235" width="520" height="380" as="geometry" /></mxCell>
</root>
    </mxGraphModel>
  </diagram>
</mxfile>
